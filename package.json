{
  "name": "duplicates-finder",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"yarn dev:next\" \"yarn dev:electron\"",
    "dev:next": "cd renderer && yarn dev",
    "dev:electron": "wait-on http://localhost:3000 && nodemon --watch electron --exec electron .",
    "build:renderer": "cd renderer && yarn build",
    "build": "yarn build:renderer && electron-builder"
  },
  "author": "Lohith",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.11",
    "wait-on": "^9.0.3"
  }
}
